# Copie este archivo como .env y ajuste los valores. .env no se versiona.
PUERTO=3000
# Obligatorio en producción (NODE_ENV=production). En desarrollo se genera uno aleatorio.
JWT_SECRETO=cambie-este-secreto
JWT_DURACION_SEGUNDOS=3600
BCRYPT_RONDAS=10
# Administrador inicial: se crea al arrancar si no existe ninguno.
ADMIN_CORREO=admin@uni.edu
ADMIN_CONTRASENA=Admin12345
ADMIN_NOMBRE=Administrador del sistema
