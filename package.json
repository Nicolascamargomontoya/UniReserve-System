{
  "name": "unireserve-system",
  "version": "2.0.0",
  "description": "Sistema de gestión de reservas de espacios académicos, desarrollado con SDD y OpenSpec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "test": "vitest run",
    "pruebas:cobertura": "vitest run --coverage",
    "tipos": "tsc --noEmit",
    "specs:validar": "openspec validate --all --strict",
    "trazabilidad": "tsx scripts/trazabilidad.ts",
    "verificar": "npm run tipos && npm run specs:validar && npm run pruebas:cobertura && npm run trazabilidad"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.15.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
